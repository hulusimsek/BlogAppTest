@using BlogApp.Application.DTOs.BlogPost
@using Microsoft.AspNetCore.Http.Extensions
@using BlogApp.Application.DTOs.Tag
@model BlogApp.Web.ViewModels.BlogDetailViewModel

@{
    var metaTitle = !string.IsNullOrEmpty(Model?.BlogPost?.MetaTitle)
        ? Model.BlogPost.MetaTitle
        : Model?.BlogPost?.Title ?? Model?.BlogPost.Title;

    var metaDescription = !string.IsNullOrEmpty(Model?.BlogPost?.MetaDescription)
        ? Model.BlogPost.MetaDescription
        : Model?.BlogPost?.Summary ?? "";

    ViewData["Title"] = metaTitle;
    ViewData["MetaDescription"] = metaDescription;
    ViewData["MetaKeywords"] = Model?.BlogPost?.MetaKeywords ?? "";
    ViewData["Robots"] = "index, follow";

    ViewData["ogDecription"] = Model?.BlogPost.Summary;
    ViewData["ogImage"] = Model?.BlogPost.FeaturedImageUrl;
    ViewData["imageAlt"] = Model?.BlogPost.FeaturedImageUrl;
    ViewData["ogType"] = "article";

    int wordCount = Model?.BlogPost?.Content?.Split(' ').Length ?? 0;
    int readingTime = (int)Math.Ceiling(wordCount / 200.0); // Dakika başına 200 kelime

}

<div class="max-w-[1200px] mx-auto px-4 py-6">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 lg:gap-8">
        <!-- Ana İçerik -->
        <article class="lg:col-span-3" itemscope itemtype="https://schema.org/BlogPosting">
            <!-- Başlık ve Meta Bilgiler -->
            <div class="mb-6">
                <!-- Kategori -->
                @if (!string.IsNullOrEmpty(Model?.BlogPost?.CategoryName))
                {
                    <a asp-action="Category" asp-route-slug="@Model.BlogPost.CategorySlug"
                       class="inline-block text-sm font-semibold text-primary hover:text-primary-dark mb-3 transition-colors">
                        @Model.BlogPost.CategoryName
                    </a>
                }

                <!-- Başlık -->
                <h1 itemprop="headline" class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4 leading-tight">
                    @Model?.BlogPost?.Title
                </h1>

                <!-- Meta Bilgiler -->
                <div class="flex flex-wrap items-center gap-4 text-sm text-gray-600 dark:text-gray-400 mb-4">
                    <div class="flex items-center gap-2">
                        @if (!string.IsNullOrEmpty(Model?.BlogPost?.AuthorImageUrl))
                        {
                            <img src="@Model.BlogPost.AuthorImageUrl"
                                 alt="@Model.BlogPost.AuthorName"
                                 class="w-8 h-8 rounded-full object-cover"
                                 loading="lazy">
                        }
                        <span itemprop="author" itemscope itemtype="https://schema.org/Person">
                            <span itemprop="name" class="font-medium text-gray-900 dark:text-white">
                                @Model?.BlogPost?.AuthorName
                            </span>
                            @if (!string.IsNullOrEmpty(Model?.BlogPost?.AuthorImageUrl))
                            {
                                <meta itemprop="url" content="@Model.BlogPost.AuthorImageUrl" />
                            }
                            <meta itemprop="url" href="@($"{Context.Request.Scheme}://{Context.Request.Host}/hakkimizda")" />
                        </span>
                    </div>
                    <span class="text-gray-400">•</span>
                    <time itemprop="datePublished" datetime="@Model?.BlogPost?.PublishDate?.ToString("yyyy-MM-ddTHH:mm:ssZ")">
                        @Model?.BlogPost?.PublishDate?.ToString("dd MMMM yyyy")
                    </time>
                    <span class="text-gray-400">•</span>
                    <span class="flex items-center gap-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                        @Model?.BlogPost?.ViewCount görüntülenme
                    </span>

                    <span class="flex items-center gap-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        @readingTime dakika okuma
                    </span>
                </div>

                <!-- ✅ Ekle -->
                <meta property="article:published_time" content="@Model?.BlogPost?.PublishDate?.ToString("yyyy-MM-ddTHH:mm:sszzz")" />
                <meta property="article:modified_time" content="@(Model?.BlogPost?.ModifiedDate?.ToString("yyyy-MM-ddTHH:mm:sszzz") ?? Model?.BlogPost?.PublishDate?.ToString("yyyy-MM-ddTHH:mm:sszzz"))" />
                <meta property="article:author" content="@Model?.BlogPost?.AuthorName" />
                <meta property="article:section" content="@Model?.BlogPost?.CategoryName" />
                <!-- Etiketler -->
                @if (Model?.BlogPost?.Tags != null && Model.BlogPost.Tags.Any())
                {
                    <div class="flex flex-wrap gap-2 mb-6">
                        @foreach (var tag in Model.BlogPost.Tags)
                        {
                            <a asp-action="Tag" asp-route-slug="@tag.Slug"
                               class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-[#e6f2ff] text-[#0066cc]
                                              dark:bg-[#004080] dark:text-[#99ccff]
                                              hover:bg-[#cce5ff] dark:hover:bg-[#0055aa]
                                              rounded transition-colors">
                                #@tag.Name
                            </a>
                        }
                    </div>
                }
            </div>

            <!-- Öne Çıkan Görsel -->
            @if (!string.IsNullOrEmpty(Model?.BlogPost?.FeaturedImageUrl))
            {
                <div class="mb-8 rounded-lg overflow-hidden shadow-lg">
                    <img itemprop="image"
                         src="@Model.BlogPost.FeaturedImageUrl"
                         alt="@Model.BlogPost.Title - @Model.BlogPost.CategoryName blog yazısı görseli"
                         title="@Model.BlogPost.Title"
                         class="w-full h-auto object-cover"
                         loading="lazy">
                </div>
            }

            <!-- İçerik -->
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6 sm:p-8 mb-8">
                <div itemprop="articleBody" class="prose prose-lg dark:prose-invert max-w-none
                     prose-headings:font-bold prose-headings:text-gray-900 dark:prose-headings:text-white
                     prose-p:text-gray-700 dark:prose-p:text-gray-300 prose-p:leading-relaxed
                     prose-a:text-primary prose-a:no-underline hover:prose-a:underline
                     prose-img:rounded-lg prose-img:shadow-md
                     prose-pre:bg-gray-900 prose-pre:text-gray-100
                     prose-code:text-primary prose-code:bg-gray-100 dark:prose-code:bg-gray-700 prose-code:px-1 prose-code:py-0.5 prose-code:rounded
                     prose-blockquote:border-l-4 prose-blockquote:border-primary prose-blockquote:pl-4 prose-blockquote:italic
                     prose-ul:list-disc prose-ol:list-decimal">
                    @Html.Raw(Model?.BlogPost?.Content)
                </div>
            </div>

            <!-- ✅ FAQ Bölümü - BURAYA EKLE -->
            @if (Model?.BlogPost?.Faqs != null && Model.BlogPost.Faqs.Any())
            {
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6 sm:p-8 mt-8 mb-8">
                    <button class="w-full text-left flex items-center justify-between group"
                            onclick="toggleAllFAQs()"
                            type="button"
                            aria-expanded="false"
                            id="faq-toggle-button">
                        <h2 class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-primary transition-colors duration-200">
                            Sık Sorulan Sorular
                        </h2>
                        <svg class="w-6 h-6 text-gray-500 dark:text-gray-400 transform transition-transform duration-200 group-hover:text-primary"
                             fill="none"
                             stroke="currentColor"
                             viewBox="0 0 24 24"
                             id="faq-toggle-icon">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>

                    <!-- FAQ Content - Initially Hidden -->
                    <div class="hidden mt-6"
                         id="faq-content"
                         itemscope
                         itemtype="https://schema.org/FAQPage">
                        <div class="space-y-6">
                            @foreach (var faq in Model.BlogPost.Faqs)
                            {
                                <div class="border-b border-gray-200 dark:border-gray-700 pb-4 last:border-0 last:pb-0"
                                     itemscope
                                     itemprop="mainEntity"
                                     itemtype="https://schema.org/Question">
                                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3 flex items-start gap-3"
                                        itemprop="name">
                                        <svg class="w-5 h-5 text-primary flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                                        </svg>
                                        @faq.Question
                                    </h3>
                                    <div class="text-gray-700 dark:text-gray-300 leading-relaxed ml-8"
                                         itemscope
                                         itemprop="acceptedAnswer"
                                         itemtype="https://schema.org/Answer">
                                        <div itemprop="text">
                                            @Html.Raw(faq.Answer)
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Paylaşım Butonları -->
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Bu yazıyı paylaş</h3>

                <div class="flex flex-wrap gap-2">
                    <!-- Twitter -->
                    <button onclick="shareOnTwitter()"
                            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:border-[#1DA1F2] hover:bg-[#1DA1F2] hover:text-white transition-all text-sm">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                        </svg>
                        <span class="font-medium">Twitter</span>
                    </button>

                    <!-- Facebook -->
                    <button onclick="shareOnFacebook()"
                            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:border-[#1877F2] hover:bg-[#1877F2] hover:text-white transition-all text-sm">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                        </svg>
                        <span class="font-medium">Facebook</span>
                    </button>

                    <!-- LinkedIn -->
                    <button onclick="shareOnLinkedIn()"
                            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:border-[#0A66C2] hover:bg-[#0A66C2] hover:text-white transition-all text-sm">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                        </svg>
                        <span class="font-medium">LinkedIn</span>
                    </button>

                    <!-- WhatsApp -->
                    <button onclick="shareOnWhatsApp()"
                            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:border-[#25D366] hover:bg-[#25D366] hover:text-white transition-all text-sm">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
                        </svg>
                        <span class="font-medium">WhatsApp</span>
                    </button>

                    <!-- E-posta -->
                    <button onclick="shareViaMail()"
                            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:border-gray-500 hover:bg-gray-100 dark:hover:bg-gray-600 transition-all text-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                        <span class="font-medium">E-posta</span>
                    </button>

                    <!-- Link Kopyala -->
                    <button onclick="copyToClipboard()" id="copyButton"
                            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:border-gray-500 hover:bg-gray-100 dark:hover:bg-gray-600 transition-all text-sm">
                        <svg id="copyIcon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        <svg id="checkIcon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span id="copyText" class="font-medium">Kopyala</span>
                    </button>
                </div>

                <!-- Success Message -->
                <div id="successMessage" class="hidden mt-3 p-2.5 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-md">
                    <div class="flex items-center gap-2 text-green-700 dark:text-green-300">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span class="text-sm">Link başarıyla kopyalandı!</span>
                    </div>
                </div>
            </div>


            <!-- İlgili Yazılar -->
            @if (Model?.RelatedPosts != null && Model.RelatedPosts.Any())
            {
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 mt-8 p-6 mb-8">
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">İlgili Yazılar</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        @foreach (var post in Model.RelatedPosts)
                        {
                            <div class="flex flex-col bg-gray-50 dark:bg-gray-700/50 rounded-lg overflow-hidden border border-gray-200 dark:border-gray-600 hover:shadow-md transition-all">
                                @if (!string.IsNullOrEmpty(post.FeaturedImageUrl))
                                {
                                    <a asp-action="Detail" asp-route-slug="@post.Slug" class="block">
                                        <img src="@post.FeaturedImageUrl"
                                             alt="@post.Title"
                                             class="w-full h-32 object-cover"
                                             loading="lazy">
                                    </a>
                                }
                                <div class="p-4 flex-grow">
                                    <h4 class="font-semibold text-sm text-gray-900 dark:text-white mb-2 line-clamp-2">
                                        <a asp-action="Detail" asp-route-slug="@post.Slug"
                                           class="hover:text-primary transition-colors">
                                            @post.Title
                                        </a>
                                    </h4>
                                    <p class="text-xs text-gray-600 dark:text-gray-400 line-clamp-2">
                                        @post.Summary
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Yorumlar -->
            @if (Model?.BlogPost?.Comments != null && Model.BlogPost.Comments.Any())
            {
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6">
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-6">
                        Yorumlar (@Model.BlogPost.Comments.Count(c => c.IsApproved))
                    </h3>
                    <div class="space-y-6">
                        @foreach (var comment in Model.BlogPost.Comments.Where(c => c.IsApproved))
                        {
                            <div class="flex gap-4">
                                <div class="flex-shrink-0">
                                    @if (!string.IsNullOrEmpty(comment.AuthorImageUrl))
                                    {
                                        <img src="@comment.AuthorImageUrl"
                                             alt="@comment.AuthorName"
                                             class="w-10 h-10 rounded-full object-cover"
                                             loading="lazy">
                                    }
                                    else
                                    {
                                        <div class="w-10 h-10 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center">
                                            <span class="text-sm font-semibold text-gray-600 dark:text-gray-300">
                                                @comment.AuthorName.Substring(0, 1).ToUpper()
                                            </span>
                                        </div>
                                    }
                                </div>
                                <div class="flex-grow">
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="font-semibold text-sm text-gray-900 dark:text-white">
                                            @comment.AuthorName
                                        </span>
                                        <span class="text-xs text-gray-500 dark:text-gray-400">
                                            @comment.CommentDate.ToString("dd.MM.yyyy HH:mm")
                                        </span>
                                    </div>
                                    <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
                                        @comment.Content
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </article>

        <!-- Sidebar -->
        <aside class="lg:col-span-1 space-y-6">
            <!-- Popüler Yazılar -->
            @if (Model?.PopularBlogPosts != null && Model.PopularBlogPosts.Any())
            {
                <div class="bg-white dark:bg-gray-800 px-5 pb-5 pt-2 mt-2 rounded-lg shadow-sm border border-gray-100 dark:border-gray-700">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-3">Popüler Yazılar</h3>
                    <ul class="space-y-3">
                        @foreach (var post in Model.PopularBlogPosts)
                        {
                            <li class="pb-3 border-b border-gray-100 dark:border-gray-700 last:border-0">
                                <a asp-action="Detail" asp-route-slug="@post.Slug"
                                   class="block group">
                                    <h4 class="text-sm font-medium text-gray-900 dark:text-white group-hover:text-primary transition-colors line-clamp-2 mb-1">
                                        @post.Title
                                    </h4>
                                    <div class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
                                        <span>@post.PublishDate?.ToString("dd.MM.yyyy")</span>
                                        <span>•</span>
                                        <span class="flex items-center gap-1">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                            </svg>
                                            @post.ViewCount
                                        </span>
                                    </div>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            <!-- Kategoriler -->
            @if (Model?.Categories != null && Model.Categories.Any())
            {
                <div class="bg-white dark:bg-gray-800 px-5 pb-5 pt-2 rounded-lg shadow-sm border border-gray-100 dark:border-gray-700">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-3">Kategoriler</h3>
                    <ul class="space-y-2 text-sm">
                        @foreach (var category in Model.Categories)
                        {
                            var isActive = Model?.BlogPost?.CategorySlug == category.Slug;
                            <li>
                                <a asp-action="Category" asp-route-slug="@category.Slug"
                                   class="@(isActive ? "text-primary font-semibold" : "text-gray-600 dark:text-gray-300 hover:text-primary") transition-colors">
                                    @category.Name
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            <!-- Etiketler -->
            <!-- Etiketler -->
            @if (Model?.Tags != null && Model.Tags.Any())
            {
                <div class="bg-white dark:bg-gray-800 px-5 pb-5 pt-2 rounded-lg shadow-sm text-center md:text-left border border-gray-100 dark:border-gray-700">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-3">Etiketler</h3>

                    <div id="tagContainer" class="flex flex-wrap gap-2 max-h-24 overflow-hidden transition-all duration-300 justify-center md:justify-start">
                        @foreach (var tag in Model.Tags)
                        {
                            <a asp-action="Tag" asp-route-slug="@tag.Slug"
                               class="px-2 py-1 rounded text-xs sm:text-sm font-medium bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300 hover:bg-blue-100 hover:text-blue-700 dark:hover:bg-blue-900/30 dark:hover:text-blue-300 transition-colors">
                                #@tag.Name
                            </a>
                        }
                    </div>

                    @if (Model.Tags.Count > 12)
                    {
                        <div class="flex justify-center md:justify-start">
                            <button id="toggleTags" class="flex items-center gap-1 mt-3 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 focus:outline-none">
                                <span id="toggleText">Daha Fazla Göster</span>
                                <svg id="toggleIcon" class="w-4 h-4 transform rotate-0 transition-transform duration-200"
                                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>
                        </div>
                    }
                </div>
            }
        </aside>
    </div>
</div>

@section Styles {
    <style>
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .share-btn {
            animation: fadeIn 0.3s ease-out forwards;
        }

            .share-btn:nth-child(1) {
                animation-delay: 0s;
            }

            .share-btn:nth-child(2) {
                animation-delay: 0.05s;
            }

            .share-btn:nth-child(3) {
                animation-delay: 0.1s;
            }

            .share-btn:nth-child(4) {
                animation-delay: 0.15s;
            }

            .share-btn:nth-child(5) {
                animation-delay: 0.2s;
            }

            .share-btn:nth-child(6) {
                animation-delay: 0.25s;
            }

        .tooltip {
            visibility: hidden;
            opacity: 0;
            transition: all 0.2s ease;
        }

        .share-btn:hover .tooltip {
            visibility: visible;
            opacity: 1;
        }
    </style>

    <style>
        .rotate-180 {
            transform: rotate(180deg);
        }
    </style>
}

@section Scripts {
    <script>
        // Test için örnek veriler
        const pageUrl = window.location.href;
        const pageTitle = 'İcra Takibi ve İflas Süreci Hakkında Detaylı Bilgiler';
        const pageDescription = 'İcra takibi ve iflas süreçleri, yasal haklar ve prosedürler hakkında kapsamlı rehber';

        // Twitter paylaşımı
        function shareOnTwitter() {
            const url = `https://twitter.com/intent/tweet?text=${encodeURIComponent(pageTitle)}&url=${encodeURIComponent(pageUrl)}`;
            window.open(url, '_blank', 'width=600,height=400');
        }

        // Facebook paylaşımı
        function shareOnFacebook() {
            const url = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`;
            window.open(url, '_blank', 'width=600,height=400');
        }

        // LinkedIn paylaşımı - DÜZELTİLDİ
        function shareOnLinkedIn() {
            // LinkedIn artık URL parametrelerini desteklemiyor, sadece URL paylaşıyor
            // Ancak meta tags varsa (og:title, og:description) onları otomatik çekiyor
            const url = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`;
            document.getElementById('linkedinStatus').textContent = '✅ Açıldı (Meta tags gerekli)';
            window.open(url, '_blank', 'width=600,height=600');
        }

        // WhatsApp paylaşımı - DÜZELTİLDİ
        function shareOnWhatsApp() {
            const text = `${pageTitle}\n\n${pageUrl}`;
            const encodedText = encodeURIComponent(text);

            // Önce native app protokolünü dene
            const appUrl = `whatsapp://send?text=${encodedText}`;
            const webUrl = `https://web.whatsapp.com/send?text=${encodedText}`;

            // App açmayı dene
            const iframe = document.createElement('iframe');
            iframe.style.display = 'none';
            iframe.src = appUrl;
            document.body.appendChild(iframe);

            // Eğer 1 saniye içinde kullanıcı başka sayfaya yönlenmezse web'e aç
            setTimeout(() => {
                document.body.removeChild(iframe);
                window.open(webUrl, '_blank');
            }, 1000);
        }

        // E-posta paylaşımı
        function shareViaMail() {
            const subject = pageTitle;
            const body = `Merhaba,\n\nBu yazıyı sizinle paylaşmak istedim:\n\n${pageTitle}\n\n${pageUrl}\n\nİyi okumalar!`;
            window.location.href = `mailto:?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }

        // Link kopyalama
        function copyToClipboard() {
            const url = window.location.href;
            const copyButton = document.getElementById('copyButton');
            const copyText = document.getElementById('copyText');
            const copyIcon = document.getElementById('copyIcon');
            const checkIcon = document.getElementById('checkIcon');
            const successMessage = document.getElementById('successMessage');

            navigator.clipboard.writeText(url).then(() => {
                copyIcon.classList.add('hidden');
                checkIcon.classList.remove('hidden');
                copyText.textContent = 'Kopyalandı!';
                copyButton.classList.remove('border-gray-300', 'dark:border-gray-600');
                copyButton.classList.add('border-green-500', 'bg-green-50', 'dark:bg-green-900/20', 'text-green-700', 'dark:text-green-300');

                successMessage.classList.remove('hidden');

                setTimeout(() => {
                    successMessage.classList.add('hidden');
                    copyIcon.classList.remove('hidden');
                    checkIcon.classList.add('hidden');
                    copyText.textContent = 'Kopyala';
                    copyButton.classList.add('border-gray-300', 'dark:border-gray-600');
                    copyButton.classList.remove('border-green-500', 'bg-green-50', 'dark:bg-green-900/20', 'text-green-700', 'dark:text-green-300');
                }, 2000);
            }).catch(err => {
                console.error('Kopyalama hatası:', err);
                alert('Link kopyalanamadı. Lütfen manuel olarak kopyalayın.');
            });
        }
    </script>

    <script>
        function toggleAllFAQs() {
            const content = document.getElementById('faq-content');
            const icon = document.getElementById('faq-toggle-icon');
            const button = document.getElementById('faq-toggle-button');
            const isExpanded = button.getAttribute('aria-expanded') === 'true';

            if (isExpanded) {
                // Close
                content.classList.add('hidden');
                icon.classList.remove('rotate-180');
                button.setAttribute('aria-expanded', 'false');
            } else {
                // Open
                content.classList.remove('hidden');
                icon.classList.add('rotate-180');
                button.setAttribute('aria-expanded', 'true');
            }
        }

        // Ensure schema markup is always accessible to search engines
        document.addEventListener('DOMContentLoaded', function() {
            // Schema markup is in the HTML, so search engines can read it even if hidden

            const toggleButton = document.getElementById('toggleTags');
            if (!toggleButton) return;

            const container = document.getElementById('tagContainer');
            const text = document.getElementById('toggleText');
            const icon = document.getElementById('toggleIcon');

            toggleButton.addEventListener('click', () => {
                container.classList.toggle('max-h-24');
                const expanded = !container.classList.contains('max-h-24');
                text.textContent = expanded ? 'Daha Az Göster' : 'Daha Fazla Göster';
                icon.classList.toggle('rotate-180', expanded);
            });
        });
    </script>

    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "BlogPosting",
          "headline": "@Model?.BlogPost?.Title",
          "description": "@Model?.BlogPost?.Summary",
          "image": {
            "@@type": "ImageObject",
            "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}{Model?.BlogPost?.FeaturedImageUrl}")",
            "width": 1200,
            "height": 630
          },
          "author": {
            "@@type": "Person",
            "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}/hakkimizda")",
            "name": "@Html.SafePlainText(Model?.BlogPost?.AuthorName)"
          },
          "publisher": {
            "@@type": "Organization",
            "name": "@Html.SafePlainText(Model?.BlogPost?.AuthorName)",
            "logo": {
              "@@type": "ImageObject",
              "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}/images/logo.png")",
              "width": 180,
              "height": 180
            }
          },
          "datePublished": "@Model?.BlogPost?.PublishDate?.ToString("yyyy-MM-ddTHH:mm:sszzz")",
          "dateModified": "@(Model?.BlogPost?.ModifiedDate?.ToString("yyyy-MM-ddTHH:mm:sszzz") ?? Model?.BlogPost?.PublishDate?.ToString("yyyy-MM-ddTHH:mm:sszzz"))",
          "mainEntityOfPage": {
            "@@type": "WebPage",
            "@@id": "@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")"
          },
          "wordCount": @(Model?.BlogPost?.Content?.Split(' ').Length ?? 0),
          "articleSection": "@Html.SafePlainText(Model?.BlogPost?.CategoryName)",
          "keywords": "@Html.SafePlainText(string.Join(", ", Model?.BlogPost?.Tags?.Select(t => t.Name) ?? new List<string>()))"
        }
    </script>

    <!-- İlgili Yazılar Schema -->
    @if (Model?.RelatedPosts != null && Model.RelatedPosts.Any())
    {
        <script type="application/ld+json">
            {
              "@@context": "https://schema.org",
              "@@type": "ItemList",
              "itemListElement": [
                @for (int i = 0; i < Model.RelatedPosts.Count(); i++)
                {
                                    var post = Model.RelatedPosts.ElementAt(i);
                                    @:{
                                    @:  "@@type": "ListItem",
                                    @:  "position": @(i + 1),
                                    @:  "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}/blog/{post.Slug}")"
                                    @:}@(i < Model.RelatedPosts.Count() - 1 ? "," : "")
                }
              ]
            }
        </script>
    }
}