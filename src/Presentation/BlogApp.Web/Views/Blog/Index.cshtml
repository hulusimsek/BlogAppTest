@using BlogApp.Application.DTOs.BlogPost
@using BlogApp.Application.DTOs.ServiceCategory
@using BlogApp.Application.DTOs.Tag
@model BlogApp.Web.ViewModels.BlogViewModel

@{
    var categoryOrTag = !string.IsNullOrEmpty(Model.CurrentCategoryName)
        ? Model.CurrentCategoryName
        : !string.IsNullOrEmpty(Model.CurrentTagName)
        ? Model.CurrentTagName
        : string.Empty;

    var metaTitle = !string.IsNullOrEmpty(Model?.Section?.MetaTitle) ? Model.Section.MetaTitle : "Blog Sayfası";
    var pageTitle = !string.IsNullOrEmpty(categoryOrTag)
    ? $"{categoryOrTag} - {metaTitle}"
    : $"{metaTitle}";
    var pageMetaDescription = $"{categoryOrTag} {Model?.Section?.MetaDescription}";

    ViewData["Title"] = pageTitle;
    ViewData["MetaDescription"] = pageMetaDescription;
    ViewData["MetaKeywords"] = Model?.Section?.MetaKeywords ?? "";
    ViewData["Robots"] = "index, follow";
}

@functions {
    string BuildUrlWithout(string keyToRemove)
    {
        var deneme = Context.Request.Query;
        var query = Context.Request.Query
            .Where(q => q.Key != keyToRemove)
            .ToDictionary(q => q.Key, q => q.Value.ToString());

        var queryString = string.Join("&", query.Select(kvp => $"{kvp.Key}={kvp.Value}"));
        return Url.Action("Index") + (string.IsNullOrEmpty(queryString) ? "" : "?" + queryString);
    }
}


<div class="max-w-[1200px] mx-auto px-4 py-6">
    <!-- Başlık ve Açıklama -->
    <div class="mb-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-3">
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
                @if (!string.IsNullOrEmpty(Model?.CurrentCategoryName))
                {
                    <text>@Model?.CurrentCategoryName @Model?.Section?.AlternativeTitleExplanation</text>
                }
                else if (!string.IsNullOrEmpty(Model?.CurrentTagName))
                {
                    <text>@Model.CurrentTagName @Model?.Section?.AlternativeTitle</text>
                }
                else
                {
                    <text>@Model?.Section?.Title</text>
                }
            </h1>

            <!-- Minimal Filtre Toggle Butonu -->
            <div class="flex justify-between items-center mb-3">
                <button id="filterToggle"
                        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm hover:bg-gray-50 dark:hover:bg-gray-700 transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                    </svg>
                    <span>Filtrele</span>
                    <svg id="filterToggleIcon" class="w-4 h-4 transition-transform duration-300 ml-1"
                         fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
            </div>

        </div>

        @if (Model?.TotalCount > 0)
        {
            <div class="mt-3 text-sm text-gray-600 dark:text-gray-400">
                <span class="font-medium text-gray-900 dark:text-white">@Model.TotalCount</span> @Model?.Section?.ButtonAltText
                <span class="text-gray-500 dark:text-gray-500"> (toplam @Model?.AllTotalCount)</span>
            </div>
        }
    </div>

    <!-- Gizlenebilir Filtre Alanı -->
    <div id="filterSection"
         class="max-h-0 overflow-hidden transition-[max-height,opacity] duration-500 ease-in-out opacity-0">
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md border border-gray-200 dark:border-gray-700 p-5">
            <form method="get" asp-action="Index" class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <!-- Arama -->
                    <div class="lg:col-span-2">
                        <input type="text" name="searchTitle" value="@Model?.SearchTitle"
                               placeholder="Başlık ara..."
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-md bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    </div>

                    <!-- Sıralama -->
                    <div>
                        <select name="sortBy"
                                class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-md bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500">
                            <option value="PublishDate" selected="@(Model?.SortBy == "PublishDate")">Tarih</option>
                            <option value="Title" selected="@(Model?.SortBy == "Title")">Başlık</option>
                            <option value="ViewCount" selected="@(Model?.SortBy == "ViewCount")">Popüler</option>
                        </select>
                    </div>

                    <!-- Yön -->
                    <div>
                        <select name="descending"
                                class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-md bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500">
                            <option value="true" selected="@Model?.Descending">Azalan</option>
                            <option value="false" selected="@(!Model?.Descending)">Artan</option>
                        </select>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model?.CurrentCategorySlug))
                {
                    <input type="hidden" name="categorySlug" value="@Model.CurrentCategorySlug" />
                }
                @if (!string.IsNullOrEmpty(Model?.CurrentTag))
                {
                    <input type="hidden" name="tag" value="@Model.CurrentTag" />
                }

                <div class="flex justify-end gap-2 pt-2">
                    <button type="submit"
                            class="px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-md transition-colors">
                        Uygula
                    </button>
                    <a asp-action="Index"
                       class="px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-md transition-colors">
                        Temizle
                    </a>
                </div>
            </form>
        </div>
    </div>



    <!-- Aktif Filtreler (Küçük Badges) -->
    @if (!string.IsNullOrEmpty(Model?.CurrentCategoryName) || !string.IsNullOrEmpty(Model?.CurrentTag) || !string.IsNullOrEmpty(Model?.SearchTitle))
    {
        <div class="flex flex-wrap gap-2 mb-6">
            @if (!string.IsNullOrEmpty(Model.CurrentCategoryName))
            {
                <a href="@BuildUrlWithout("categorySlug")"
                   class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium bg-[#f5f0ff] text-[#8b7bd4]
                   dark:bg-[#6a5acd] dark:text-[#e6e0ff]
                   hover:bg-[#eae0ff] dark:hover:bg-[#7b68ee]
                   rounded transition-colors">
                    <span>@Model.CurrentCategoryName</span>
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </a>
            }

            @if (!string.IsNullOrEmpty(Model.CurrentTag))
            {
                <a href="@BuildUrlWithout("tag")"
                   class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium
                                    bg-[#e6f2ff] text-[#0066cc]
                      dark:bg-[#004080] dark:text-[#99ccff]
                      hover:bg-[#cce5ff] dark:hover:bg-[#0055aa]
                      rounded transition-colors">
                    <span>#@Model.CurrentTag</span>
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </a>
            }

            @if (!string.IsNullOrEmpty(Model.SearchTitle))
            {
                <a href="@BuildUrlWithout("searchTitle")"
                   class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium bg-[#fff0e6] text-[#cc5500]
                      dark:bg-[#663300] dark:text-[#ffcc99]
                      hover:bg-[#ffe0cc] dark:hover:bg-[#884400]
                      rounded transition-colors">
                    <span>"@Model.SearchTitle"</span>
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </a>
            }

        </div>
    }

    <!-- İçerik -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 lg:gap-8">
        <!-- Yazılar -->
        <div class="lg:col-span-3">
            @if (Model != null && Model.BlogPosts.Any())
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-5">
                    @foreach (var post in Model.BlogPosts)
                    {
                        <div class="flex flex-col h-full bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden border border-gray-200 dark:border-gray-700 hover:shadow-md transition-all duration-300" itemscope itemtype="https://schema.org/Blog">
                            <article class="flex flex-col h-full">

                                <meta itemprop="datePublished" content="@post.PublishDate" />
                                <meta itemprop="author" content="@post.AuthorName" />

                                <!-- Resim -->
                                @if (!string.IsNullOrEmpty(post.FeaturedImageUrl))
                                {
                                    <div class="w-full h-44 sm:h-48 bg-gray-200 dark:bg-gray-700 overflow-hidden flex-shrink-0">
                                        <a asp-action="Detail" asp-route-slug="@post.Slug">
                                            <img itemprop="image"
                                                 src="@post.FeaturedImageUrl"
                                                 alt="@post.Title"
                                                 loading="lazy"
                                                 width="400"
                                                 height="225"
                                                 class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
                                                 onerror="this.parentElement.style.display='none'">
                                        </a>
                                    </div>
                                }

                                <div class="p-4 flex flex-col flex-grow">

                                    <!-- Kategori -->
                                    @if (!string.IsNullOrEmpty(post.CategoryName))
                                    {
                                        <a asp-action="Category" asp-route-slug="@post.CategorySlug"
                                           class="inline-block text-xs font-semibold text-primary hover:text-primary-dark mb-2 transition-colors">
                                            @post.CategoryName
                                        </a>
                                    }

                                    <!-- Başlık -->
                                    <h2 itemprop="headline" class="text-base sm:text-lg font-semibold text-gray-900 dark:text-white mb-2 line-clamp-2 leading-tight">
                                        <a asp-action="Detail" asp-route-slug="@post.Slug"
                                           class="hover:text-primary transition-colors duration-200">
                                            @post.Title
                                        </a>
                                    </h2>

                                    <!-- Özet -->
                                    <p itemprop="description" class="text-gray-600 dark:text-gray-300 text-xs sm:text-sm leading-relaxed mb-3 line-clamp-3 flex-grow">
                                        @post.Summary
                                    </p>

                                    <!-- Etiketler -->
                                    @if (post.Tags != null && post.Tags.Any())
                                    {
                                        <div class="flex flex-wrap gap-1.5 mb-3">
                                            @foreach (var tag in post.Tags.Take(3))
                                            {
                                                <a asp-action="Tag" asp-route-slug="@tag.Slug"
                                                   class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-[#e6f2ff] text-[#0066cc]
                                      dark:bg-[#004080] dark:text-[#99ccff]
                                      hover:bg-[#cce5ff] dark:hover:bg-[#0055aa]
                                      rounded transition-colors">
                                                    #@tag.Name
                                                </a>
                                            }
                                            @if (post.Tags.Count > 3)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-400">
                                                    +@(post.Tags.Count - 3)
                                                </span>
                                            }
                                        </div>
                                    }

                                    <!-- Footer -->
                                    <div class="mt-auto pt-3 border-t border-gray-100 dark:border-gray-700 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                                        <div class="flex items-center gap-2">
                                            <span>@post.PublishDate?.ToString("dd.MM.yyyy")</span>
                                            <span>•</span>
                                            <span class="flex items-center gap-1">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                </svg>
                                                @post.ViewCount
                                            </span>
                                        </div>
                                        <a asp-action="Detail" asp-route-slug="@post.Slug"
                                           class="text-xs font-medium text-primary hover:text-primary-dark transition-colors inline-flex items-center gap-1">
                                            Oku
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    }
                </div>

            }
            else
            {
                <div class="text-center py-12 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
                    <div class="text-gray-400 dark:text-gray-500 mb-4">
                        <svg class="w-16 h-16 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                        </svg>
                    </div>
                    <p class="text-gray-600 dark:text-gray-400">
                        @if (!string.IsNullOrEmpty(Model?.CurrentCategorySlug))
                        {
                            <text>Bu kategoride henüz yazı bulunmamaktadır.</text>
                        }
                        else if (!string.IsNullOrEmpty(Model?.CurrentTag))
                        {
                            <text>Bu etiketle ilgili yazı bulunmamaktadır.</text>
                        }
                        else
                        {
                            <text>Henüz blog yazısı bulunmamaktadır.</text>
                        }
                    </p>
                </div>
            }

            <!-- Sayfalama -->
            @if (Model?.TotalPages > 1)
            {
                <nav class="flex flex-wrap justify-center items-center gap-2 mt-8" aria-label="Sayfalama">
                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-action="Index"
                           asp-route-categorySlug="@Model.CurrentCategorySlug"
                           asp-route-tag="@Model.CurrentTag"
                           asp-route-searchTitle="@Model.SearchTitle"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-descending="@Model.Descending"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           class="flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-md border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                           aria-label="Önceki Sayfa" rel="prev">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                            </svg>
                        </a>
                    }

                    @{
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                    }

                    @if (startPage > 1)
                    {
                        <a asp-action="Index"
                           asp-route-categorySlug="@Model.CurrentCategorySlug"
                           asp-route-tag="@Model.CurrentTag"
                           asp-route-searchTitle="@Model.SearchTitle"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-descending="@Model.Descending"
                           asp-route-page="1"
                           class="flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-md text-sm font-medium border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                            1
                        </a>
                        @if (startPage > 2)
                        {
                            <span class="text-gray-500 dark:text-gray-400">...</span>
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <a asp-action="Index"
                           asp-route-categorySlug="@Model.CurrentCategorySlug"
                           asp-route-tag="@Model.CurrentTag"
                           asp-route-searchTitle="@Model.SearchTitle"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-descending="@Model.Descending"
                           asp-route-page="@i"
                           class="flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-md text-sm font-medium transition-colors
                                                                  @(i == Model.CurrentPage
                                                                                           ? "bg-primary text-white border border-primary shadow-sm"
                                                                                           : "border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700")"
                   aria-current="@(i == Model.CurrentPage ? "page" : null)">
                    @i
                </a>
                                }

                    @if (endPage < Model.TotalPages)
                    {
                        @if (endPage < Model.TotalPages - 1)
                        {
                            <span class="text-gray-500 dark:text-gray-400">...</span>
                        }
                        <a asp-action="Index"
                           asp-route-categorySlug="@Model.CurrentCategorySlug"
                           asp-route-tag="@Model.CurrentTag"
                           asp-route-searchTitle="@Model.SearchTitle"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-descending="@Model.Descending"
                           asp-route-page="@Model.TotalPages"
                           class="flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-md text-sm font-medium border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                            @Model.TotalPages
                        </a>
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a asp-action="Index"
                           asp-route-categorySlug="@Model.CurrentCategorySlug"
                           asp-route-tag="@Model.CurrentTag"
                           asp-route-searchTitle="@Model.SearchTitle"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-descending="@Model.Descending"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           class="flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-md border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                           aria-label="Sonraki Sayfa" rel="next">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </a>
                    }
                </nav>
            }
        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-1 space-y-6">
            <!-- Popüler Yazılar -->
            @if (Model?.PopularBlogPosts != null && Model.PopularBlogPosts.Any())
            {
                <div class="bg-white dark:bg-gray-800 px-5 pb-5 pt-2 rounded-lg shadow-sm text-center md:text-left border border-gray-100 dark:border-gray-700">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-3">Popüler Yazılar</h3>
                    <ul class="space-y-2 text-sm">
                        @foreach (var post in Model.PopularBlogPosts)
                        {
                            <li>
                                <a asp-action="Detail" asp-route-slug="@post.Slug"
                                   class="text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                                    @post.Title
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            <!-- Kategoriler -->
            @if (Model?.Categories != null && Model.Categories.Any())
            {
                <div class="bg-white dark:bg-gray-800 px-5 pb-5 pt-2 rounded-lg shadow-sm text-center md:text-left border border-gray-100 dark:border-gray-700">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-3">Kategoriler</h3>
                    <ul class="space-y-2 text-sm">
                        @foreach (var category in Model.Categories)
                        {
                            var isActive = Model?.CurrentCategorySlug == category.Slug;
                            <li>
                                <a asp-action="Category" asp-route-slug="@category.Slug"
                                   class="@(isActive ? "text-blue-600 dark:text-blue-400 font-semibold" : "text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400") transition-colors">
                                    @category.Name
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            <!-- Etiketler -->
            @if (Model?.Tags != null && Model.Tags.Any())
            {
                <div class="bg-white dark:bg-gray-800 px-5 pb-5 pt-2 rounded-lg shadow-sm text-center md:text-left border border-gray-100 dark:border-gray-700">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-3">Etiketler</h3>

                    <div id="tagContainer" class="flex flex-wrap gap-2 max-h-24 overflow-hidden transition-all duration-300 justify-center md:justify-start">
                        @foreach (var tag in Model.Tags)
                        {
                            <a asp-action="Tag" asp-route-slug="@tag.Slug"
                               class="px-2 py-1 rounded text-xs sm:text-sm font-medium bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300 hover:bg-blue-100 hover:text-blue-700 dark:hover:bg-blue-900/30 dark:hover:text-blue-300 transition-colors">
                                #@tag.Name
                            </a>
                        }
                    </div>

                    @if (Model.Tags.Count > 12)
                    {
                        <div class="flex justify-center md:justify-start">
                            <button id="toggleTags" class="flex items-center gap-1 mt-3 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 focus:outline-none">
                                <span id="toggleText">Daha Fazla Göster</span>
                                <svg id="toggleIcon" class="w-4 h-4 transform rotate-0 transition-transform duration-200"
                                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>
                        </div>
                    }
                </div>
            }
        </aside>
    </div>
</div>

@section Styles {
    <style>
        .line-clamp-2 {
            overflow: hidden;
            display: -webkit-box;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
        }

        .line-clamp-3 {
            overflow: hidden;
            display: -webkit-box;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 3;
        }

        /* Fix flex grow issues */
        article {
            min-height: 0;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Filtre Toggle
        const toggle = document.getElementById('filterToggle');
        const section = document.getElementById('filterSection');
        const filterToggleIcon = document.getElementById('filterToggleIcon');

        const isFiltered =
            new URLSearchParams(window.location.search).toString().length > 0;

        // Sayfa yüklendiğinde filtre varsa açık başlat
        if (isFiltered) {
            section.classList.add('opacity-100', 'mb-8');
            section.classList.remove('opacity-0');
            section.style.maxHeight = section.scrollHeight + 'px';
            filterToggleIcon.classList.add('rotate-180');
        }

        // Toggle butonuna tıklama
        toggle.addEventListener('click', (e) => {
            e.preventDefault();
            const isOpen = section.classList.contains('opacity-100');

            if (isOpen) {
                section.classList.remove('opacity-100', 'mb-8');
                section.classList.add('opacity-0');
                section.style.maxHeight = '0px';
                filterToggleIcon.classList.remove('rotate-180');
            } else {
                section.classList.remove('opacity-0');
                section.classList.add('opacity-100', 'mb-8');
                section.style.maxHeight = section.scrollHeight + 'px';
                filterToggleIcon.classList.add('rotate-180');
            }
        });

            // Tag Toggle
            const toggleButton = document.getElementById('toggleTags');
            if (!toggleButton) return;

            const container = document.getElementById('tagContainer');
            const text = document.getElementById('toggleText');
            const icon = document.getElementById('toggleIcon');

            toggleButton.addEventListener('click', () => {
                container.classList.toggle('max-h-24');
                const expanded = !container.classList.contains('max-h-24');
                text.textContent = expanded ? 'Daha Az Göster' : 'Daha Fazla Göster';
                icon.classList.toggle('rotate-180', expanded);
            });
        });
    </script>

    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "ItemList",
          "name": "Blog Yazıları",
          "url": "@(Context.Request.Scheme)://@(Context.Request.Host)@(Context.Request.Path)",
          "itemListElement": [
            @for (int i = 0; i < Model?.BlogPosts.Count; i++)
            {
                            var blog = Model.BlogPosts[i];
                        <text>{
                              "@@type": "ListItem",
                          "position": @(i + 1),
                          "url": "@(Context.Request.Scheme)://@(Context.Request.Host)/blog/@blog.Slug",
                          "name": "@blog.Title"
                        }</text>
                            @(i < Model.BlogPosts.Count - 1 ? "," : "")
            }
          ]
        }
    </script>
}