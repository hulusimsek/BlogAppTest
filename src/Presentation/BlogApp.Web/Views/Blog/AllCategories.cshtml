@model BlogApp.Web.ViewModels.BlogViewModel

@{
    var metaTitle = !string.IsNullOrEmpty(Model?.Section?.MetaTitle) ? Model.Section.MetaTitle : "Kategoriler";

    var metaDescription = !string.IsNullOrEmpty(Model?.Section?.MetaDescription)
                            ? Model.Section.MetaDescription : "Blog yazılarında yer alan tüm kategorilerin listesi.";
    ViewData["Title"] = metaTitle;
    ViewData["MetaDescription"] = metaDescription;


    ViewData["Robots"] = "index, follow";
}

<div class="max-w-[1200px] mx-auto px-4 py-6">
    <!-- Sayfa Başlığı -->
    <div class="mb-4">
        <div class="border-b border-gray-200 dark:border-gray-700 pb-1">
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">@Model?.Section?.Title</h1>
            <p class="text-gray-600 dark:text-gray-400 text-sm sm:text-base">
                @Model?.Section?.TitleExplanation
            </p>

            @if (@Model?.Tags.Count() > 0)
            {
                <div class="mt-3 text-sm text-gray-600 dark:text-gray-400 mt-2">
                    <span class="font-medium text-gray-900 dark:text-white">@Model?.Categories.Count()</span> @Model?.Section?.ButtonAltText
                </div>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 pt-2">
        <!-- Kategoriler -->
        <section class="lg:col-span-3 pt-2">
            @if (Model?.Categories != null && Model.Categories.Any())
            {
                <div class="flex flex-wrap gap-2 sm:gap-3">
                    @foreach (var category in Model.Categories.OrderBy(c => c.Name))
                    {
                        <a asp-action="Category"
                           asp-route-slug="@category.Slug"
                           title="@($"{category.Name} kategorili yazılar")"
                           class="px-3 py-1.5 text-sm font-medium rounded-full border border-gray-300 dark:border-gray-600
                                          text-gray-700 dark:text-gray-200 hover:border-blue-500 hover:text-blue-600
                                          dark:hover:border-blue-400 dark:hover:text-blue-400 transition-colors">
                            @category.Name
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-12 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
                    <p class="text-gray-600 dark:text-gray-400">Henüz hiç kategori bulunmamaktadır.</p>
                </div>
            }
        </section>

        <!-- Sidebar -->
        <aside class="lg:col-span-1 space-y-6">
            <!-- Popüler Yazılar -->
            @if (Model?.PopularBlogPosts != null && Model.PopularBlogPosts.Any())
            {
                <div class="bg-white dark:bg-gray-800 px-5 pb-5 pt-2 rounded-lg shadow-sm text-center md:text-left border border-gray-100 dark:border-gray-700">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-3">Popüler Yazılar</h3>
                    <ul class="space-y-2 text-sm">
                        @foreach (var post in Model.PopularBlogPosts.Take(5))
                        {
                            <li>
                                <a asp-action="Detail" asp-route-slug="@post.Slug"
                                   class="text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                                    @post.Title
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            <!-- Etiketler -->
            @if (Model?.Tags != null && Model.Tags.Any())
            {
                <div class="bg-white dark:bg-gray-800 px-5 pb-5 pt-2 rounded-lg shadow-sm text-center md:text-left border border-gray-100 dark:border-gray-700" ">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-3">Etiketler</h3>

                    <div id="tagContainer" class="flex flex-wrap gap-2 max-h-24 overflow-hidden transition-all duration-300 justify-center md:justify-start">
                        @foreach (var tag in Model.Tags)
                        {
                            <a asp-action="Tag" asp-route-slug="@tag.Slug"
                               class="px-2 py-1 rounded text-xs sm:text-sm font-medium bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300 hover:bg-blue-100 hover:text-blue-700 dark:hover:bg-blue-900/30 dark:hover:text-blue-300 transition-colors">
                                #@tag.Name
                            </a>
                        }
                    </div>

                    @if (Model.Tags.Count > 12)
                    {
                        <div class="flex justify-center md:justify-start">
                            <button id="toggleTags" class="flex items-center gap-1 mt-3 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 focus:outline-none">
                                <span id="toggleText">Daha Fazla Göster</span>
                                <svg id="toggleIcon" class="w-4 h-4 transform rotate-0 transition-transform duration-200"
                                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>
                        </div>
                    }
                </div>
            }
        </aside>
    </div>
</div>


@section Scripts {
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "ItemList",
          "name": "@Html.SafePlainText(Model?.Section?.MetaTitle ?? "Blog Kategorileri")",
          "description": "Elif Eylül Hukuk Blogu'ndaki tüm yazı kategorilerinin listesi.",
          "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")",
          "itemListElement": [
            @for (int i = 0; i < Model?.Categories.Count; i++)
            {
                    var c = Model.Categories[i];
                    <text>
                    {
                      "@@type": "ListItem",
                      "position": @(i + 1),
                      "name": "@c.Name",
                      "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}/blog/kategori/{c.Slug}")"
                    }@(i < Model.Categories.Count - 1 ? "," : "")
                    </text>
            }
          ]
        }
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Filtre Toggle
            const filterToggle = document.getElementById('filterToggle');
            const filterSection = document.getElementById('filterSection');
            const filterToggleIcon = document.getElementById('filterToggleIcon');

            if (filterToggle && filterSection) {
                filterToggle.addEventListener('click', () => {
                    filterSection.classList.toggle('hidden');
                    filterToggleIcon.classList.toggle('rotate-180');
                });
            }

            // Tag Toggle
            const toggleButton = document.getElementById('toggleTags');
            if (!toggleButton) return;

            const container = document.getElementById('tagContainer');
            const text = document.getElementById('toggleText');
            const icon = document.getElementById('toggleIcon');

            toggleButton.addEventListener('click', () => {
                container.classList.toggle('max-h-24');
                const expanded = !container.classList.contains('max-h-24');
                text.textContent = expanded ? 'Daha Az Göster' : 'Daha Fazla Göster';
                icon.classList.toggle('rotate-180', expanded);
            });
        });
    </script>
}
