@model BlogApp.Web.ViewModels.ContactViewModel


@{
    var metaTitle = !string.IsNullOrEmpty(Model?.Section?.MetaTitle)
        ? Model.Section.MetaTitle
        : $"İletişim - {Model?.SiteSettings?.SiteName}";

    var metaDescription = !string.IsNullOrEmpty(Model?.Section?.MetaDescription)
        ? Model.Section.MetaDescription
        : $"{Model?.SiteSettings?.SiteName} ile iletişime geçin. Adres: {Model?.ContactInfo?.StreetAddress}, {Model?.ContactInfo?.AddressLocality}/{Model?.ContactInfo?.AddressRegion} - Telefon: {Model?.ContactInfo?.Phone}";

    ViewData["Title"] = metaTitle;
    ViewData["MetaDescription"] = metaDescription;
    ViewData["Robots"] = "index, follow";

}

<div class="py-8 md:py-12">
    <div class="container mx-auto px-4">
        <div class="text-center mb-4">
            <h1 class="text-primary-dark dark:text-white text-3xl md:text-4xl font-bold leading-tight tracking-[-0.033em]">
                @Model?.Section?.Title
            </h1>
            <p class="mt-4 text-gray-600 dark:text-gray-400 text-base font-normal leading-normal max-w-2xl mx-auto">
                @Model?.Section?.TitleExplanation
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-12">
            <!-- Sol Taraf - İletişim Bilgileri, Harita ve FAQ -->
            <div class="lg:col-span-2 bg-white dark:bg-gray-800 p-8 rounded-xl shadow-lg flex flex-col gap-10 self-start">

                <!-- İletişim Bilgileri -->
                <div itemscope itemtype="https://schema.org/ContactPoint">
                    <h2 class="text-xl font-bold text-primary-dark dark:text-white mb-6">
                        İletişim Bilgilerimiz
                    </h2>
                    <div class="grid sm:grid-cols-2 gap-x-8 gap-y-6">
                        <!-- Adres -->
                        <div class="flex items-start gap-4">
                            <div class="text-primary dark:text-primary flex items-center justify-center rounded-lg bg-gray-light dark:bg-gray-700 shrink-0 size-10">
                                <span class="material-symbols-outlined !text-2xl" aria-hidden="true">location_on</span>
                            </div>
                            <div class="flex-1">
                                <p class="text-gray-500 dark:text-gray-400 text-xs font-semibold mb-1">
                                    Adres
                                </p>
                                <address class="text-gray-800 dark:text-gray-200 text-sm font-normal leading-normal not-italic" itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
                                    <span itemprop="streetAddress">@Model?.ContactInfo?.StreetAddress</span>
                                    <span itemprop="addressLocality">@Model?.ContactInfo?.AddressLocality</span>
                                    <span itemprop="addressRegion">@Model?.ContactInfo?.AddressRegion</span>
                                    <span itemprop="postalCode">@Model?.ContactInfo?.PostalCode</span>
                                    <span itemprop="addressCountry">@Model?.ContactInfo?.AddressCountry</span>
                                </address>
                            </div>
                        </div>

                        <!-- Telefon -->
                        <div class="flex items-start gap-4">
                            <div class="text-primary dark:text-primary flex items-center justify-center rounded-lg bg-gray-light dark:bg-gray-700 shrink-0 size-10">
                                <span class="material-symbols-outlined !text-2xl" aria-hidden="true">phone</span>
                            </div>
                            <div class="flex-1">
                                <p class="text-gray-500 dark:text-gray-400 text-xs font-semibold mb-1">
                                    Telefon
                                </p>
                                <a class="text-gray-800 dark:text-gray-200 text-sm font-normal leading-normal hover:underline"
                                   href="tel:@Model?.ContactInfo?.Phone" itemprop="telephone">
                                    @Model.ContactInfo?.Phone
                                </a>
                            </div>
                        </div>

                        <!-- E-posta -->
                        <div class="flex items-start gap-4 sm:col-span-2">
                            <div class="text-primary dark:text-primary flex items-center justify-center rounded-lg bg-gray-light dark:bg-gray-700 shrink-0 size-10">
                                <span class="material-symbols-outlined !text-2xl" aria-hidden="true">email</span>
                            </div>
                            <div class="flex-1">
                                <p class="text-gray-500 dark:text-gray-400 text-xs font-semibold mb-1">
                                    E-posta
                                </p>
                                <a class="text-gray-800 dark:text-gray-200 text-sm font-normal leading-normal truncate hover:underline"
                                   href="mailto:@Model.ContactInfo?.Email" itemprop="email">
                                    @Model.ContactInfo?.Email
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Harita -->
                @if (!string.IsNullOrEmpty(Model.ContactInfo?.MapEmbedUrl))
                {
                    <div>
                        <h3 class="text-2xl font-bold text-primary-dark dark:text-white mb-6">
                            Konumumuz
                        </h3>
                        <div class="rounded-xl overflow-hidden shadow-lg aspect-video">
                            <iframe class="w-full h-full"
                                    src="@Model.ContactInfo.MapEmbedUrl"
                                    title="@Model.SiteSettings?.SiteName Konum Haritası"
                                    aria-label="Ofis konumumuzu gösteren harita"
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade"
                                    allowfullscreen
                                    style="border: 0">
                            </iframe>
                        </div>
                    </div>
                }


                <!-- Sıkça Sorulan Sorular -->
                @if (Model.ContactInfo?.Faqs != null && Model.ContactInfo.Faqs.Any())
                {
                    <div itemscope itemtype="https://schema.org/FAQPage">
                        <h2 class="text-xl font-bold text-primary-dark dark:text-white mb-6">
                            Sıkça Sorulan Sorular
                        </h2>
                        <div class="space-y-4">
                            @foreach (var faq in Model.ContactInfo.Faqs)
                            {
                                <details class="group p-4 rounded-lg bg-gray-light dark:bg-gray-700/50" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
                                    <summary class="flex items-center justify-between cursor-pointer font-semibold text-base text-primary-dark dark:text-white list-none">
                                        <span itemprop="name">@faq.Question</span>
                                        <div class="relative flex items-center justify-center size-7">
                                            <span class="material-symbols-outlined transition-transform duration-300 group-open:rotate-180" aria-hidden="true">expand_more</span>
                                        </div>
                                    </summary>
                                    <div class="mt-4 text-sm text-gray-600 dark:text-gray-300" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                                        <p itemprop="text">@faq.Answer</p>
                                    </div>
                                </details>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Sağ Taraf - Hızlı Erişim, Çalışma Saatleri ve Sosyal Medya -->
            <div class="flex flex-col gap-10">
                <!-- Hızlı Erişim -->
                @if (!string.IsNullOrEmpty(Model.SiteSettings?.ButtonLink) && Model.SiteSettings.ButtonIsActive)
                {
                    <div class="bg-white dark:bg-gray-800 p-8 rounded-xl shadow-lg">
                        <h3 class="text-xl font-bold text-primary-dark dark:text-white mb-6">
                           @Model?.Section?.Subtitle
                        </h3>
                        <div class="flex flex-col gap-4">
                            <a href="@Model?.SiteSettings.ButtonLink"
                               class="w-full flex min-w-[120px] max-w-full cursor-pointer items-center justify-center overflow-hidden rounded-lg h-12 px-5 bg-primary hover:bg-secondary-dark text-white text-base font-bold leading-normal tracking-[0.015em] transition-colors"
                               title="@Model?.Section?.BackgroundAltText"
                               aria-label="@Model?.Section?.BackgroundAltText">
                                <span class="truncate">@Model?.Section?.ButtonText</span>
                            </a>
                            <a class="w-full flex min-w-[120px] max-w-full cursor-pointer items-center justify-center gap-2 overflow-hidden rounded-lg h-12 px-5 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-primary-dark dark:text-white text-base font-bold leading-normal tracking-[0.015em] transition-colors"
                               href="tel:@Model?.ContactInfo?.Phone"
                               title="Telefonla müşteri desteği alın"
                               aria-label="Telefonla müşteri desteği alın">
                                <span class="material-symbols-outlined !text-2xl" aria-hidden="true">call</span>
                                <span class="truncate">Telefonla Ulaşın</span>
                            </a>
                        </div>
                    </div>
                }

                <!-- Çalışma Saatlerimiz -->
                @if (Model?.ContactInfo?.WorkingHours != null && Model.ContactInfo.WorkingHours.Any())
                {
                    <div class="bg-white dark:bg-gray-800 p-8 rounded-xl shadow-lg">
                        <h3 class="text-xl font-bold text-primary-dark dark:text-white mb-6">
                            Çalışma Saatlerimiz
                        </h3>
                        <div class="space-y-3">
                            @foreach (var wh in Model.ContactInfo.WorkingHours)
                            {
                                var isClosed = string.IsNullOrEmpty(wh.Opens) || string.IsNullOrEmpty(wh.Closes);
                                <div class="flex items-center justify-between rounded-lg @(isClosed ? "bg-red-100 dark:bg-red-900/40" : "bg-gray-light dark:bg-gray-700/50") px-4 py-3 text-sm">
                                    <span class="font-bold @(isClosed ? "text-red-700 dark:text-red-300" : "text-primary-dark dark:text-white")">
                                        @wh.DayNameTr
                                    </span>
                                    <span class="font-@(isClosed ? "bold" : "medium") @(isClosed ? "text-red-700 dark:text-red-300" : "text-gray-800 dark:text-gray-200")">
                                        @(isClosed ? "Kapalı" : $"{wh.Opens} - {wh.Closes}")
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Sosyal Medya -->
                @if (!string.IsNullOrEmpty(Model?.SiteSettings?.FacebookUrl) ||
                                !string.IsNullOrEmpty(Model.SiteSettings?.TwitterUrl) ||
                                !string.IsNullOrEmpty(Model.SiteSettings?.LinkedInUrl) ||
                                !string.IsNullOrEmpty(Model.SiteSettings?.InstagramUrl))
                {
                    <div class="bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-md border border-gray-100 dark:border-gray-700">
                        <h3 class="text-xl font-bold text-primary-dark dark:text-white mb-4">
                            Bizi Takip Edin
                        </h3>
                        <div class="flex gap-3 flex-wrap">
                            @if (!string.IsNullOrEmpty(Model.SiteSettings?.FacebookUrl))
                            {
                                <a class="flex items-center justify-center rounded-lg h-10 w-10 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-primary hover:text-white transition-colors"
                                   href="@Model.SiteSettings.FacebookUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   aria-label="Facebook'ta bizi takip edin">
                                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.323-1.325z"></path>
                                    </svg>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(Model.SiteSettings?.TwitterUrl))
                            {
                                <a class="flex items-center justify-center rounded-lg h-10 w-10 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-primary hover:text-white transition-colors"
                                   href="@Model.SiteSettings.TwitterUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   aria-label="Twitter'da bizi takip edin">
                                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.223.085c.645 1.956 2.52 3.379 4.734 3.419-1.897 1.472-4.29 2.35-6.885 2.35-1.63 0-2.884-.23-4.043-.65 2.45 1.576 5.36 2.491 8.49 2.491 10.178 0 15.744-8.42 15.744-15.74 0-.24-.005-.478-.015-.714a11.23 11.23 0 002.788-2.885z"></path>
                                    </svg>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(Model.SiteSettings?.LinkedInUrl))
                            {
                                <a class="flex items-center justify-center rounded-lg h-10 w-10 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-primary hover:text-white transition-colors"
                                   href="@Model.SiteSettings.LinkedInUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   aria-label="LinkedIn'de bizi takip edin">
                                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667h-3.554v-11.591h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.425zM2.913 7.288h-.028c-.96 0-1.748-.788-1.748-1.761 0-.974.788-1.762 1.776-1.762.988 0 1.748.788 1.748 1.762 0 .973-.76 1.761-1.748 1.761zM4.693 20.452H1.137V8.861h3.556v11.591z"></path>
                                    </svg>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(Model.SiteSettings?.InstagramUrl))
                            {
                                <a class="flex items-center justify-center rounded-lg h-10 w-10 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-primary hover:text-white transition-colors"
                                   href="@Model.SiteSettings.InstagramUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   aria-label="Instagram'da bizi takip edin">
                                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.07 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.88 1.44 1.44 0 000-2.88z"></path>
                                    </svg>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
@{
        double? latitude = null;
        double? longitude = null;

        if (Model?.ContactInfo?.Latitude != null && Model?.ContactInfo?.Longitude != null)
        {
            latitude = Model.ContactInfo.Latitude;
            longitude = Model.ContactInfo.Longitude;
        }

        else if (!string.IsNullOrEmpty(Model?.ContactInfo?.MapEmbedUrl))
        {
            var mapUrl = Model.ContactInfo.MapEmbedUrl;
            var lonMatch = System.Text.RegularExpressions.Regex.Match(mapUrl, @"!2d([0-9\.\-]+)");
            var latMatch = System.Text.RegularExpressions.Regex.Match(mapUrl, @"!3d([0-9\.\-]+)");

            if (latMatch.Success && double.TryParse(latMatch.Groups[1].Value, System.Globalization.CultureInfo.InvariantCulture, out var lat))
            {
                latitude = lat;
            }

            if (lonMatch.Success && double.TryParse(lonMatch.Groups[1].Value, System.Globalization.CultureInfo.InvariantCulture, out var lon))
            {
                longitude = lon;
            }
        }
    }
    <!-- ✅ LocalBusiness Schema ekle -->
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "LocalBusiness",
          "@@id": "@($"{Context.Request.Scheme}://{Context.Request.Host}")",
          "name": "@Model.SiteSettings?.SiteName",
          "image": "@($"{Context.Request.Scheme}://{Context.Request.Host}{Model.SiteSettings?.LogoUrl}")",
          "telephone": "@Model.ContactInfo?.Phone",
          "email": "@Model.ContactInfo?.Email",
          "address": {
            "@@type": "PostalAddress",
            "streetAddress": "@Model.ContactInfo?.StreetAddress",
            "addressLocality": "@Model.ContactInfo?.AddressLocality",
            "addressRegion": "@Model.ContactInfo?.AddressRegion",
            "postalCode": "@Model.ContactInfo?.PostalCode",
            "addressCountry": "@Model.ContactInfo?.AddressCountry"
          }
          @if (latitude != null && longitude != null)
          {
                @:,
                @:"geo": {
                @:  "@@type": "GeoCoordinates",
                @:  "latitude": @latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture),
                @:  "longitude": @longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture)
                @:}
          }
    ,
          "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}")",
          "priceRange": "$$",
          "openingHoursSpecification": [
            @{
                    var workingHoursItems = new List<string>();
                    if (Model.ContactInfo?.WorkingHours != null)
                    {
                            foreach (var wh in Model.ContactInfo.WorkingHours)
                            {
                                    if (!string.IsNullOrEmpty(wh.Opens))
                                    {
                                            var item = $@"{{
                                                        ""@type"": ""OpeningHoursSpecification"",
                                                        ""dayOfWeek"": ""{wh.DayNameEn}"",
                                                        ""opens"": ""{wh.Opens}"",
                                                        ""closes"": ""{wh.Closes}""
                                                }}";
                                            workingHoursItems.Add(item);
                                    }
                            }
                    }
                    @Html.Raw(string.Join(",", workingHoursItems))
            }
          ],
          "sameAs": [
            @{
                    var socialUrls = new List<string>();
                    if (!string.IsNullOrEmpty(Model.SiteSettings?.FacebookUrl))
                            socialUrls.Add($"\"{Model.SiteSettings.FacebookUrl}\"");
                    if (!string.IsNullOrEmpty(Model.SiteSettings?.TwitterUrl))
                            socialUrls.Add($"\"{Model.SiteSettings.TwitterUrl}\"");
                    if (!string.IsNullOrEmpty(Model.SiteSettings?.LinkedInUrl))
                            socialUrls.Add($"\"{Model.SiteSettings.LinkedInUrl}\"");
                    if (!string.IsNullOrEmpty(Model.SiteSettings?.InstagramUrl))
                            socialUrls.Add($"\"{Model.SiteSettings.InstagramUrl}\"");

                    @Html.Raw(string.Join(",", socialUrls))
            }
          ]
        }
    </script>
}