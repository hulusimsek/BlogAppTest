@using BlogApp.Web.ViewModels
@model LayoutViewModel

<footer class="bg-white dark:bg-gray-800 border-t border-solid border-t-[#e0e0e0] dark:border-t-gray-700 mt-12">
    <div class="max-w-[1200px] mx-auto py-8 px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 text-center lg:text-left">

            <!-- 1. Sütun: Site Bilgileri -->
            <div class="md:col-span-3 flex flex-col items-center lg:items-start">
                <h3 class="text-lg font-bold text-secondary dark:text-white">
                    @Model.SiteSettings?.SiteName
                </h3>
                <p class="mt-2 text-gray-500 dark:text-gray-400">
                    @Model.SiteSettings?.FooterText
                </p>
            </div>

            <!-- 2. Sütun: Hızlı Linkler -->
            <div class="md:col-span-2 flex flex-col items-center">
                <h4 class="text-md font-bold text-secondary dark:text-white text-center">Hızlı Linkler</h4>
                <ul class="mt-4 space-y-2 text-center">
                    <li><a class="text-gray-500 dark:text-gray-400 hover:text-primary" asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                    <li><a class="text-gray-500 dark:text-gray-400 hover:text-primary" asp-controller="About" asp-action="Index">Hakkımızda</a></li>
                    <li><a class="text-gray-500 dark:text-gray-400 hover:text-primary" asp-controller="Services" asp-action="Index">Hizmetlerimiz</a></li>
                    <li><a class="text-gray-500 dark:text-gray-400 hover:text-primary" asp-controller="Contact" asp-action="Index">İletişim</a></li>
                </ul>
            </div>

            <!-- 3. Sütun: Hizmetler -->
            <!-- 3. Sütun: Hizmetler -->
            @if (Model.Services != null && Model.Services.Any())
            {
                int grupBoyutu = 4;
                var serviceGroups = Model.Services
                .Select((service, index) => new { service, index })
                .GroupBy(x => x.index / grupBoyutu)
                .Select(g => g.Select(x => x.service).ToList())
                .ToList();

                int sutunSayisi = serviceGroups.Count;

                <div class="md:col-span-5 flex flex-col items-center">
                    <h4 class="text-lg font-bold text-secondary dark:text-white mb-3 text-center">
                        <span class="pb-1">Hizmetlerimiz</span>
                    </h4>

                    <div class="flex flex-wrap justify-center gap-x-6 gap-y-1">
                        @foreach (var group in serviceGroups)
                        {
                            <div class="space-y-1 text-center">
                                @foreach (var service in group)
                                {
                                    <a class="text-gray-500 dark:text-gray-400 hover:text-primary transition-colors duration-200 text-sm block"
                                       asp-controller="Services"
                                       asp-action="Details"
                                       asp-route-slug="@service.Slug">
                                        @service.Name
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="md:col-span-5"></div>
            }

            <!-- 4. Sütun: Sosyal Medya -->
            <div class="md:col-span-2 flex flex-col items-center">
                <h4 class="text-md font-bold text-secondary dark:text-white text-center">Bizi Takip Edin</h4>
                <div class="flex mt-4 space-x-4 text-gray-600 dark:text-gray-300">

                    @if (!string.IsNullOrEmpty(Model.SiteSettings?.FacebookUrl))
                    {
                        <a href="@Model.SiteSettings.FacebookUrl" target="_blank" class="hover:text-primary transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="inline-block align-middle h-6 w-6 md:h-9 md:w-9 fill-current text-gray-500 hover:text-primary transition-colors duration-200"
                                 viewBox="0 0 640 640">
                                <path d="M160 96C124.7 96 96 124.7 96 160L96 480C96 515.3 124.7 544 160 544L258.2 544L258.2 398.2L205.4 398.2L205.4 320L258.2 320L258.2 286.3C258.2 199.2 297.6 158.8 383.2 158.8C399.4 158.8 427.4 162 438.9 165.2L438.9 236C432.9 235.4 422.4 235 409.3 235C367.3 235 351.1 250.9 351.1 292.2L351.1 320L434.7 320L420.3 398.2L351 398.2L351 544L480 544C515.3 544 544 515.3 544 480L544 160C544 124.7 515.3 96 480 96L160 96z" />
                            </svg>
                        </a>
                    }

                    @if (!string.IsNullOrEmpty(Model.SiteSettings?.TwitterUrl))
                    {
                        <a href="@Model.SiteSettings.TwitterUrl" target="_blank" class="hover:text-primary transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="inline-block align-middle h-6 w-6 md:h-9 md:w-9 fill-current text-gray-500 hover:text-primary transition-colors duration-200"
                                 viewBox="0 0 640 640">
                                <path d="M160 96C124.7 96 96 124.7 96 160L96 480C96 515.3 124.7 544 160 544L480 544C515.3 544 544 515.3 544 480L544 160C544 124.7 515.3 96 480 96L160 96zM457.1 180L353.3 298.6L475.4 460L379.8 460L305 362.1L219.3 460L171.8 460L282.8 333.1L165.7 180L263.7 180L331.4 269.5L409.6 180L457.1 180zM419.3 431.6L249.4 206.9L221.1 206.9L392.9 431.6L419.3 431.6z" />
                            </svg>
                        </a>
                    }

                    @if (!string.IsNullOrEmpty(Model.SiteSettings?.InstagramUrl))
                    {
                        <a href="@Model.SiteSettings?.InstagramUrl" target="_blank" class="hover:text-primary transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="inline-block align-middle h-6 w-6 md:h-9 md:w-9 fill-current text-gray-500 hover:text-primary transition-colors duration-200"
                                 viewBox="0 0 640 640">
                                <path d="M290.4 275.7C274 286 264.5 304.5 265.5 323.8C266.6 343.2 278.2 360.4 295.6 368.9C313.1 377.3 333.8 375.5 349.6 364.3C366 354 375.5 335.5 374.5 316.2C373.4 296.8 361.8 279.6 344.4 271.1C326.9 262.7 306.2 264.5 290.4 275.7zM432.7 207.3C427.5 202.1 421.2 198 414.3 195.3C396.2 188.2 356.7 188.5 331.2 188.8C327.1 188.8 323.3 188.9 320 188.9C316.7 188.9 312.8 188.9 308.6 188.8C283.1 188.5 243.8 188.1 225.7 195.3C218.8 198 212.6 202.1 207.3 207.3C202 212.5 198 218.8 195.3 225.7C188.2 243.8 188.6 283.4 188.8 308.9C188.8 313 188.9 316.8 188.9 320C188.9 323.2 188.9 327 188.8 331.1C188.6 356.6 188.2 396.2 195.3 414.3C198 421.2 202.1 427.4 207.3 432.7C212.5 438 218.8 442 225.7 444.7C243.8 451.8 283.3 451.5 308.8 451.2C312.9 451.2 316.7 451.1 320 451.1C323.3 451.1 327.2 451.1 331.4 451.2C356.9 451.5 396.2 451.9 414.3 444.7C421.2 442 427.4 437.9 432.7 432.7C438 427.5 442 421.2 444.7 414.3C451.9 396.3 451.5 356.9 451.2 331.3C451.2 327.1 451.1 323.2 451.1 319.9C451.1 316.6 451.1 312.8 451.2 308.5C451.5 283 451.9 243.6 444.7 225.5C442 218.6 437.9 212.4 432.7 207.1L432.7 207.3zM365.6 251.8C383.7 263.9 396.2 282.7 400.5 304C404.8 325.3 400.3 347.5 388.2 365.6C382.2 374.6 374.5 382.2 365.6 388.2C356.7 394.2 346.6 398.3 336 400.4C314.7 404.6 292.5 400.2 274.4 388.1C256.3 376 243.8 357.2 239.5 335.9C235.2 314.6 239.7 292.4 251.7 274.3C263.7 256.2 282.6 243.7 303.9 239.4C325.2 235.1 347.4 239.6 365.5 251.6L365.6 251.6zM394.8 250.5C391.7 248.4 389.2 245.4 387.7 241.9C386.2 238.4 385.9 234.6 386.6 230.8C387.3 227 389.2 223.7 391.8 221C394.4 218.3 397.9 216.5 401.6 215.8C405.3 215.1 409.2 215.4 412.7 216.9C416.2 218.4 419.2 220.8 421.3 223.9C423.4 227 424.5 230.7 424.5 234.5C424.5 237 424 239.5 423.1 241.8C422.2 244.1 420.7 246.2 419 248C417.3 249.8 415.1 251.2 412.8 252.2C410.5 253.2 408 253.7 405.5 253.7C401.7 253.7 398 252.6 394.9 250.5L394.8 250.5zM544 160C544 124.7 515.3 96 480 96L160 96C124.7 96 96 124.7 96 160L96 480C96 515.3 124.7 544 160 544L480 544C515.3 544 544 515.3 544 480L544 160zM453 453C434.3 471.7 411.6 477.6 386 478.9C359.6 480.4 280.4 480.4 254 478.9C228.4 477.6 205.7 471.7 187 453C168.3 434.3 162.4 411.6 161.2 386C159.7 359.6 159.7 280.4 161.2 254C162.5 228.4 168.3 205.7 187 187C205.7 168.3 228.5 162.4 254 161.2C280.4 159.7 359.6 159.7 386 161.2C411.6 162.5 434.3 168.3 453 187C471.7 205.7 477.6 228.4 478.8 254C480.3 280.3 480.3 359.4 478.8 385.9C477.5 411.5 471.7 434.2 453 452.9L453 453z" />
                            </svg>
                        </a>

                    }

                    @if (!string.IsNullOrEmpty(Model.SiteSettings?.LinkedInUrl))
                    {
                        <a href="@Model.SiteSettings.LinkedInUrl" target="_blank" class="hover:text-primary transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="inline-block align-middle h-6 w-6 md:h-9 md:w-9 fill-current text-gray-500 hover:text-primary transition-colors duration-200"
                                 viewBox="0 0 640 640">
                                <path d="M160 96C124.7 96 96 124.7 96 160L96 480C96 515.3 124.7 544 160 544L480 544C515.3 544 544 515.3 544 480L544 160C544 124.7 515.3 96 480 96L160 96zM165 266.2L231.5 266.2L231.5 480L165 480L165 266.2zM236.7 198.5C236.7 219.8 219.5 237 198.2 237C176.9 237 159.7 219.8 159.7 198.5C159.7 177.2 176.9 160 198.2 160C219.5 160 236.7 177.2 236.7 198.5zM413.9 480L413.9 376C413.9 351.2 413.4 319.3 379.4 319.3C344.8 319.3 339.5 346.3 339.5 374.2L339.5 480L273.1 480L273.1 266.2L336.8 266.2L336.8 295.4L337.7 295.4C346.6 278.6 368.3 260.9 400.6 260.9C467.8 260.9 480.3 305.2 480.3 362.8L480.3 480L413.9 480z" />
                            </svg>
                        </a>
                    }

                </div>
            </div>
        </div>

        <div class="mt-8 border-t border-gray-200 dark:border-gray-700 pt-4 text-center text-gray-500 dark:text-gray-400 text-sm">
            © @DateTime.UtcNow.Year @Model.SiteSettings?.SiteName. Tüm hakları saklıdır.
        </div>
    </div>
</footer>