@model BlogApp.Web.ViewModels.AboutViewModel

@{
    var fullName = Model?.LawyerProfile?.FullName ?? "";
    var title = Model?.LawyerProfile?.Title ?? "";
    var aboutText = Model?.LawyerProfile?.AboutText ?? "";

    var metaDescription = aboutText.Length > 150
        ? aboutText.Substring(0, 150)
        : aboutText;
}
@{
    ViewData["Title"] = "Hakkımızda";
    ViewData["Title"] = $"{Model?.LawyerProfile?.FullName} - Hakkında | {title}";
}

@{
    ViewData["MetaDescription"] = $"{fullName} - {title} | {metaDescription}";
}


<div class="flex-1 bg-background-light dark:bg-background-dark">
    <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
        <div class="layout-content-container flex flex-col">
            @if (Model?.LawyerProfile != null)
            {
                <!-- Profile Card -->
                <div class="flex p-4 @@container bg-white dark:bg-gray-800 rounded-lg shadow-md">
                    <div class="flex w-full flex-col gap-8 md:flex-row md:justify-between md:items-center">
                        <div class="flex flex-col md:flex-row gap-6 items-center">
                            <img src="@Model.LawyerProfile.ProfileImageUrl" alt="@Model.LawyerProfile.FullName profesyonel portre fotoğrafı" class="rounded-full w-40 h-40 object-cover" />

                            <div class="flex flex-col justify-center text-center md:text-left">
                                <h1 class="text-primary-dark dark:text-white text-3xl font-bold leading-tight tracking-tight">
                                    @Model.LawyerProfile.FullName
                                </h1>
                                <p class="text-accent-gray dark:text-gray-300 text-lg font-semibold leading-normal">
                                    @Model.LawyerProfile.Title
                                </p>
                                @if (Model.LawyerProfile.Specializations.Any())
                                {
                                    <p class="text-accent-gray dark:text-gray-400 text-base font-normal leading-normal mt-1">
                                        @string.Join(", ", Model.LawyerProfile.Specializations.Select(s => s.Name))
                                    </p>
                                }
                            </div>
                        </div>
                        <div class="flex w-full flex-col sm:flex-row max-w-md gap-3 @@[480px]:w-auto">
                            @if (Model.ContactInfo != null && !string.IsNullOrEmpty(Model.ContactInfo.Email))
                            {
                                <a href="mailto:@Model.ContactInfo.Email"
                                   class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg py-3 px-6 bg-gray-200 dark:bg-gray-700 text-primary-dark dark:text-white text-base font-bold leading-normal tracking-wide flex-1 @@[480px]:flex-auto hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">
                                    <span class="material-symbols-outlined mr-2">email</span>
                                    <span class="truncate">E-posta Gönder</span>
                                </a>
                            }
                            @if (Model.SiteSettings != null && !string.IsNullOrEmpty(Model.SiteSettings.LinkedInUrl))
                            {
                                <a href="@Model.SiteSettings.LinkedInUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg py-3 px-6 bg-primary text-white text-base font-bold leading-normal tracking-wide flex-1 @@[480px]:flex-auto hover:bg-primary-dark transition-colors">
                                    <span class="material-symbols-outlined mr-2">business_center</span>
                                    <span class="truncate">LinkedIn Profili</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>

                <!-- About Section -->
                @if (!string.IsNullOrEmpty(Model.LawyerProfile.AboutText))
                {
                    <div class="mt-12 bg-white dark:bg-gray-800 p-8 rounded-lg shadow-md">
                        <h2 class="text-primary-dark dark:text-white text-2xl font-bold leading-tight tracking-tight">
                            Hakkımda
                        </h2>
                        <div class="w-20 h-1 bg-primary mt-2 mb-6"></div>
                        <div class="text-accent-gray dark:text-gray-300 text-base font-normal leading-relaxed">
                            @Html.Raw(Model.LawyerProfile.AboutText.Replace("\n", "<br />"))
                        </div>
                    </div>
                }

                <!-- Specializations Section -->
                @if (Model.LawyerProfile.Specializations.Any())
                {
                    <div class="mt-12 bg-white dark:bg-gray-800 p-8 rounded-lg shadow-md">
                        <h2 class="text-primary-dark dark:text-white text-2xl font-bold leading-tight tracking-tight">
                            Uzmanlık Alanlarım
                        </h2>
                        <div class="w-20 h-1 bg-primary mt-2 mb-6"></div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
                            @foreach (var specialization in Model.LawyerProfile.Specializations)
                            {
                                <a href="@Url.Action("Detail", "Services", new { slug = specialization.Slug })" title="@specialization.Name hizmeti hakkında detaylı bilgi">

                                    <div class="bg-background-light dark:bg-gray-700 p-6 rounded-lg flex items-center gap-4 hover:shadow-lg transition-shadow">
                                        <div class="w-12 h-12 sm:w-14 sm:h-14 flex items-center justify-center rounded-xl p-2.5">
                                            <img src="@specialization.IconName" alt="@specialization.Name icon" class="w-full h-full object-contain" />
                                        </div>
                                        <h3 class="text-primary-dark dark:text-white font-semibold text-lg">
                                            @specialization.Name
                                        </h3>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                }

                <!-- Career History Section -->
                @if (Model.LawyerProfile.CareerHistory.Any())
                {
                    <div class="mt-12 bg-white dark:bg-gray-800 p-8 rounded-lg shadow-md">
                        <h2 class="text-primary-dark dark:text-white text-2xl font-bold leading-tight tracking-tight">
                            Kariyer Yolculuğu
                        </h2>
                        <div class="w-20 h-1 bg-primary mt-2 mb-6"></div>
                        <div class="relative mt-8">
                            <div class="border-l-2 border-primary absolute h-full left-4"></div>
                            @foreach (var career in Model.LawyerProfile.CareerHistory.OrderByDescending(c => c.StartDate))
                            {
                                <div class="mb-8 pl-12 relative">
                                    <div class="absolute w-8 h-8 bg-primary rounded-full -left-4 border-4 border-white dark:border-gray-800"></div>
                                    <p class="font-bold text-primary-dark dark:text-white">
                                        @career.StartDate @(string.IsNullOrEmpty(career.EndDate) ? "- Günümüz" : $"- {career.EndDate}")
                                    </p>
                                    <p class="font-semibold text-accent-gray dark:text-gray-300">
                                        @career.Position
                                    </p>
                                    <p class="text-accent-gray dark:text-gray-400">
                                        @career.Company
                                    </p>
                                    @if (!string.IsNullOrEmpty(career.Description))
                                    {
                                        <p class="text-accent-gray dark:text-gray-400 mt-2">
                                            @career.Description
                                        </p>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="bg-white dark:bg-gray-800 p-8 rounded-lg shadow-md text-center">
                    <p class="text-accent-gray dark:text-gray-300 text-lg">
                        Profil bilgisi bulunamadı.
                    </p>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
}

@section Scripts {
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "Person",
          "name": "@Html.SafePlainText(Model?.LawyerProfile?.FullName)",
          "jobTitle": "@Html.SafePlainText(Model?.LawyerProfile?.Title)",
          "url": "@(Context.Request.Scheme)://@(Context.Request.Host)@(Context.Request.Path)",
          "image": "@(Model?.LawyerProfile?.ProfileImageUrl)",
          "worksFor": {
            "@@type": "LegalService",
            "name": "@Html.SafePlainText(Model?.SiteSettings?.SiteName)",
            "url": "@(Context.Request.Scheme)://@(Context.Request.Host)",
            "telephone": "@Html.SafePlainText(@Model?.ContactInfo?.Phone)",
            "address": {
            "@@type": "PostalAddress",
            "streetAddress": "@Html.SafePlainText(Model?.ContactInfo?.StreetAddress)",
            "addressLocality": "@Html.SafePlainText(Model?.ContactInfo?.AddressLocality)",
            "addressRegion": "@Html.SafePlainText(Model?.ContactInfo?.AddressRegion)",
            "postalCode": "@Html.SafePlainText(Model?.ContactInfo?.PostalCode)",
            "addressCountry": "@Html.SafePlainText(Model?.ContactInfo?.AddressCountry)"
          },
            "image": "@(Model?.SiteSettings?.LogoUrl ?? $"")"
          },
          "sameAs": [
            "@(Model?.SiteSettings?.LinkedInUrl)",
            "@(Model?.SiteSettings?.TwitterUrl)",
            "@(Model?.SiteSettings?.FacebookUrl)",
            "@(Model?.SiteSettings?.InstagramUrl)"
          ],
          "description": "@Html.SafePlainText(Model?.LawyerProfile?.AboutText?.Replace("\n", " ") ?? "")",
                    "address": {
            "@@type": "PostalAddress",
            "streetAddress": "@Html.SafePlainText(Model?.ContactInfo?.StreetAddress)",
            "addressLocality": "@Html.SafePlainText(Model?.ContactInfo?.AddressLocality)",
            "addressRegion": "@Html.SafePlainText(Model?.ContactInfo?.AddressRegion)",
            "postalCode": "@Html.SafePlainText(Model?.ContactInfo?.PostalCode)",
            "addressCountry": "@Html.SafePlainText(Model?.ContactInfo?.AddressCountry)"
          }
        }
        }
    </script>
}




